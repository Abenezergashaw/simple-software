# Environment secrets — never commit these
.env
.env.local
.env.production

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Frontend build output
frontend/dist/
frontend/dist-ssr/

# Uploaded files (stored on server, not in git)
backend/src/uploads/*
!backend/src/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Deploy keys (never commit private keys)
deploy_key
deploy_key.pub

# Claude Code internal files
.claude/
